   "source": [
    "# 49. Result status\n",
    "\n",
    "result = input(\"Enter result (pass/fail): \").lower()\n",
    "\n",
    "match result:\n",
    "    case \"pass\":\n",
    "        print(\"Congratulations! You passed.\")\n",
    "    case \"fail\":\n",
    "        print(\"Sorry! You failed.\")\n",
    "    case _:\n",
    "        print(\"Invalid result!\")"
   ]
