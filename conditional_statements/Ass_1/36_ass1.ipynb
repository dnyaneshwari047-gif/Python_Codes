   "source": [
    "#35. Write a program to check whether a number is divisible by 3 and 5.\n",
    "num = int(input(\"Enter number:\"))\n",
    "if num % 3 == 0 and num % 5 == 0:\n",
    "    print(f\"{num} is divisible by 3 and 5\")\n",
    "else:\n",
    "    print(f\"{num} is not divisible by 3 and 5\")"
   ]
