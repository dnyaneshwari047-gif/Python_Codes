   "source": [
    "#31. Check whether a number is positive and even using nested if\n",
    "\n",
    "num = int(input(\"Enter a number: \"))\n",
    "\n",
    "if num > 0:\n",
    "    if num % 2 == 0:\n",
    "        print(\"Positive and even\")\n",
    "    else:\n",
    "        print(\"Positive but odd\")\n",
    "else:\n",
    "    print(\"Number is not positive\")\n"
   ]
