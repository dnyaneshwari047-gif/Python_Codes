    "#24. Check exam results (Distinction, First Class, Pass, Fail)\n",
    "marks = int(input(\"Enter marks: \"))\n",
    "\n",
    "if marks >= 75:\n",
    "    print(\"Distinction\")\n",
    "elif marks >= 60:\n",
    "    print(\"First Class\")\n",
    "elif marks >= 40:\n",
    "    print(\"Pass\")\n",
    "else:\n",
    "    print(\"Fail\")\n"
   ]
