   "source": [
    "#30. Check number type (single, double, or three digit)\n",
    "\n",
    "num = int(input(\"Enter a number: \"))\n",
    "num = abs(num)\n",
    "\n",
    "if num <= 9:\n",
    "    print(\"Single digit\")\n",
    "elif num <= 99:\n",
    "    print(\"Double digit\")\n",
    "elif num <= 999:\n",
    "    print(\"Three digit\")\n",
    "else:\n",
    "    print(\"More than three digits\")\n",
    "\n"
   ]
