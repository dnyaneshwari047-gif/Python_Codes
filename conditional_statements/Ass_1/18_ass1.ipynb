   "source": [
    "#18. Write a program to check whether a number is positive, negative, or zero.\n",
    "\n",
    "\n",
    "num = int(input(\"Enter number:\"))\n",
    "if num <= -1 :\n",
    "    print(\"Number is Negative!!\")\n",
    "elif num <= 0 :\n",
    "    print(\"Number is Zero!!\")\n",
    "else:\n",
    "    print(\"Number is Positive!!\")"
   ]
