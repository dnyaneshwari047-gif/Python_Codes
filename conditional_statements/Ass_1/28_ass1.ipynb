   "source": [
    "#calculate shopping discount\n",
    "\n",
    "amount = float(input(\"Enter shopping amount: \"))\n",
    "\n",
    "if amount >= 5000:\n",
    "    discount = amount * 0.10\n",
    "else:\n",
    "    discount = 0\n",
    "\n",
    "print(\"Discount:\", discount)\n",
    "print(\"Final amount:\", amount - discount)\n"
   ]
