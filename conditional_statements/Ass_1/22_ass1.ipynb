    "#22. Write a program to check salary bonus based on years of service.\n",
    "year = int(input(\"Enter Years of your service:\"))\n",
    "if year <= 5:\n",
    "    print(\" Bonus Amount : 100000\")\n",
    "elif year <= 10:\n",
    "    print(\"Bonus Amount : 200000\")\n",
    "else:\n",
    "    print(\"Bonus Amount : 300000\")"
   ]
